@model GestionDisciplinasViewModel


<h1>Disciplinas</h1>

<table class="table table-stripped mt-3">
    <thead>
        <tr>
            <th>Atleta</th>
            <th>Disciplinas</th>
            <th>Agregar disciplina</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Atleta.Nombre</td>
            @{
                if (Model.Atleta.Disciplinas == null || !Model.Atleta.Disciplinas.Any())
                {
                    <td>Aun no hay disciplinas asignadas</td>
                }
                else
                {
                    <td>
                        @foreach (var disciplina in Model.Atleta.Disciplinas)
                        {
                            <span>@disciplina.Nombre.Disciplina</span>
                            <br />
                        }
                    </td>
                }
            }
            
            <td>
            <select>
                @foreach (var disciplina in Model.Disciplinas)
                {
                    <option value="@disciplina.Id">@disciplina.Nombre.Disciplina</option>
                }
            </select>
            <a asp-action="" class="btn btn-primary">Agregar</a>
            </td>
            </tr>
    </tbody>
</table>


<br /><br />
<a asp-action="GestionDeAtletas" class="btn btn-secondary">Volver</a>
