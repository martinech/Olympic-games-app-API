@model GestionDisciplinasViewModel


<h1>Disciplinas</h1>

<table class="table table-stripped mt-3">
    <thead>
        <tr>
            <th>Atleta</th>
            <th>Disciplinas</th>
            <th>Agregar disciplina</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.AtletaDto.Nombre</td>
            @{
                if (Model.AtletaDto.DisciplinasDto == null || !Model.AtletaDto.DisciplinasDto.Any())
                {
                    <td>Aun no hay disciplinas asignadas</td>
                }
                else
                {
                <td>
                        @foreach (var disciplina in Model.AtletaDto.DisciplinasDto)
                    {
                        <span>@disciplina.Nombre.Disciplina</span>
                        <br />
                    }
                </td>
                }
            }  
            <td>
                <form asp-action="AgregarDisciplinaAlAtleta" method="post">
                    <input type="hidden" name="idAtleta" value="@Model.AtletaDto.Id" />
                    <select name="idDisciplina">
                        @foreach (var disciplina in Model.DisciplinasDto)
                        {
                            <option value="@disciplina.Id">@disciplina.Nombre</option>
                        }
                    </select>
                    <input type="submit" class="btn btn-primary "value="Agregar"/>
                </form>
            </td>
            </tr>
    </tbody>
</table>


<br /><br />
<a asp-action="GestionDeAtletas" class="btn btn-secondary">Volver</a>
