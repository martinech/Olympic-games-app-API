@model CrearEventoViewModel

@{
    ViewData["Title"] = "Crear evento";
}

<center>
    <h1>Crear nuevo evento</h1>
    <br /><br />
    <form method="post" asp-action="CrearEvento2" id="formularioEvento">
        <h4>Nombre</h4>
        <input type="text" name="nombreEvento" placeholder="Nombre del evento" id="nombreEvento" /><br /><br />
        <h4>Disciplina</h4><br />
        <select name="idDisciplina">
            @foreach (var disciplina in Model.disciplinas)
            {
                <option value="@disciplina.Id">@disciplina.Nombre</option>
            }
        </select>
        <br /><br />
        <a class="btn btn-secondary" asp-action="GestionDeEventos">Volver</a>
        <input class="btn btn-success" type="submit" value="Continuar" id="botonCrearEvento" />
    </form>
    <p id="parrafoEvento"></p>
</center>

<script type="text/javascript" src="~/js/validacionesEventos/crearEvento.js"></script>
