@model GestionEventosViewModel

@{
    ViewData["Title"] = "Gestión de Eventos";
}

<p>Bienvenido @Context.Session.GetString("rolLogueado")</p>

<h2>@ViewData["Title"]</h2>
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">
        @TempData["MensajeError"]
    </div>
}
<a  asp-controller="AmbosUsuarios" asp-action="CrearEvento" class="btn btn-success" style="float: right">Crear Evento</a>

<form method="post" asp-action="GetEventosPorFecha">
    <h5>Buscar evento por fecha</h5>
    <label>Fecha Evento</label>
    <input type="date" name="fechaEvento"/><br />
    <input class="btn btn-primary" type="submit" value="Buscar"/>
</form>


<table class="table table-stripped mt-3">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Disciplina</th>
            <th>Fecha de inicio</th>
            <th>Fecha de finalización</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var evento in Model.Eventos)
        {
            <tr>
                <td>@evento.Nombre</td>
                <td>@evento.Disciplina</td>
                <td>@evento.FechaInicio.ToString("MM-dd-yyyy")</td>
                <td>@evento.FechaFin.ToString("MM-dd-yyyy")</td>
            </tr>
        }
    </tbody>
</table>

<form asp-controller="AmbosUsuarios" asp-action="Logout" method="post">
    <input type="submit" value="Cerrar Sesion" class="btn btn-danger"/>
</form>